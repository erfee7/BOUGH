# ==========================================
# Stage 1: The Builder (Compiles Vue to static files)
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files and install dependencies
COPY package.json package-lock.json ./
RUN npm ci

# Copy the rest of the source code
COPY . .

# Run the Vite production build
RUN npm run build

# ==========================================
# Stage 2: The Runner (Serves files with Caddy)
# ==========================================
FROM caddy:2-alpine

# Remove default Caddy config
RUN rm -rf /etc/caddy/Caddyfile

# Copy our custom Caddyfile
COPY Caddyfile /etc/caddy/Caddyfile

# Copy the compiled static files from Stage 1
COPY --from=builder /app/dist /srv

# Caddy listens on 80 (HTTP) and 443 (HTTPS) by default
EXPOSE 80 443