# ==========================================
# LLM Configuration (OpenAI Compatible)
# ==========================================
# You MUST replace this with your actual key
PROVIDER_API_KEY=your_openai_compatible_provider_api_key_here
# You can also set the base URL and default model if you want to use a different endpoint or model (not mandatory)
# Non-OpenRouter provider is currently not recommended, as some features like reasoning content or usage metadata might not be working with them
# PROVIDER_BASE_URL=https://openrouter.ai/api/v1
# DEFAULT_MODEL=openai/gpt-oss-20b:free
# TITLER_MODEL=openai/gpt-oss-20b:free

# ==========================================
# Domain & HTTPS Configuration (Production)
# ==========================================
# Set this to your domain name (e.g., bough.example.com) for automatic HTTPS via Let's Encrypt.
# Unset for local HTTP testing (make prod).
# If putting behind an existing reverse proxy (like Nginx/Caddy), leave this blank and let the reverse proxy handle HTTPS.
DOMAIN=

# ==========================================
# Database Configuration (Optional)
# ==========================================
# The docker-compose.yml and backend will use a default local password
# Only uncomment and change this if you want a custom password for extra security
# POSTGRES_PASSWORD=your_pwd